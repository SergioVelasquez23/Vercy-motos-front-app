# Configuración de UN negocio para el front. Copia este archivo a `negocio.env` y rellénalo.
# Un valor por línea, formato CLAVE=valor, sin comillas. No pongas aquí secretos: el front es público en el navegador.

# Obligatorios
APP_NAME=Nombre del negocio
BACKEND_URL=https://api.ejemplo.co

# Nombre del software registrado ante la DIAN (solo si el negocio no lo guarda en Configuración)
SOFTWARE_NAME=Nombre POS

# Responsable que aparece en los textos legales (revisados por un abogado)
LEGAL_NIT=
LEGAL_DIRECCION=
CONTACT_EMAIL=
CONTACT_PHONE=

# Quién recibe el aviso de traslados de bodega (listas separadas por coma). Vacío = nadie.
NOTIF_TRASLADO_EMAILS=
NOTIF_TRASLADO_USUARIOS=
